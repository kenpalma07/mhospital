<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect to remove index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]
	
	RewriteCond %{REQUEST_URI} ^uploads/(.*)$ [NC]
    RewriteRule ^(.*)$ uploads/$1 [L]

</IfModule>
